import random

def fetch_market_data(item_name, category):
    base_avg = {
        "electronics": 60,
        "tools": 35,
        "collectibles": 80,
        "appliances": 50,
        "misc": 30
    }.get(category, 30)

    volatility = random.uniform(0.1, 0.35)
    demand_score = random.uniform(0.4, 0.95)

    recent_sales = [
        round(base_avg * random.uniform(0.8, 1.2), 2)
        for _ in range(6)
    ]

    return {
        "avg_price": round(base_avg, 2),
        "recent_sales": recent_sales,
        "volatility": round(volatility, 2),
        "demand_score": round(demand_score, 2)
    }
