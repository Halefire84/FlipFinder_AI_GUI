### ai_value_estimator.py

```python
import json
from pathlib import Path

DATA_DIR = Path("data")

def load_price_reference():
    ref_path = DATA_DIR / "price_reference.json"
    if ref_path.exists():
        with open(ref_path, "r") as f:
            return json.load(f)
    return {
        "electronics": 1.1,
        "tools": 0.9,
        "collectibles": 1.3,
        "appliances": 0.8,
        "misc": 1.0
    }

def condition_multiplier(condition):
    mapping = {
        "new": 1.2,
        "like new": 1.1,
        "used": 1.0,
        "fair": 0.8,
        "broken": 0.4
    }
    return mapping.get(condition, 1.0)

def estimate_value(item_name, item_desc, category, condition, market_data):
    price_ref = load_price_reference()
    category_factor = price_ref.get(category, 1.0)
    cond_factor = condition_multiplier(condition)

    base = market_data["avg_price"]
    demand = market_data["demand_score"]
    volatility = market_data["volatility"]

    value = base
    value *= (1 + demand * 0.3)
    value *= category_factor
    value *= cond_factor
    value *= (1 - volatility * 0.15)

    return round(value, 2)
```

