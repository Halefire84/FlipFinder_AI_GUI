### flipfinder_core.py

```python
def analyze_item(
    item_name,
    item_desc,
    category,
    condition,
    buy_price,
    market_data,
    ai_estimate,
    risk_score
):
    expected_sell_price = ai_estimate
    gross_profit = expected_sell_price - buy_price
    roi = (gross_profit / buy_price) * 100 if buy_price > 0 else 0

    if roi > 25 and risk_score < 0.5:
        recommendation = "Strong Buy"
    elif roi > 10 and risk_score < 0.7:
        recommendation = "Buy"
    elif roi > 5 and risk_score < 0.85:
        recommendation = "Speculative"
    else:
        recommendation = "Pass"

    return {
        "item_name": item_name,
        "description": item_desc,
        "category": category,
        "condition": condition,
        "buy_price": round(buy_price, 2),
        "market_data": market_data,
        "ai_estimated_sell_price": round(expected_sell_price, 2),
        "gross_profit": round(gross_profit, 2),
        "roi_percent": round(roi, 2),
        "risk_score": round(risk_score, 2),
        "recommendation": recommendation
    }
