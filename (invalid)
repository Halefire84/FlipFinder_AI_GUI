### main.py (Tkinter GUI)

```python
import json
import tkinter as tk
from tkinter import ttk, messagebox

from flipfinder_core import analyze_item
from marketplace_scraper import fetch_market_data
from ai_value_estimator import estimate_value
from risk_model import compute_risk_score
from utils import clean_text


class FlipFinderGUI(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("FlipFinder AI — GUI")
        self.geometry("520x520")
        self._build_ui()

    def _build_ui(self):
        pad = 8

        # Item name
        tk.Label(self, text="Item name").grid(row=0, column=0, sticky="w", padx=pad, pady=pad)
        self.entry_name = tk.Entry(self, width=40)
        self.entry_name.grid(row=0, column=1, padx=pad, pady=pad)

        # Description
        tk.Label(self, text="Description").grid(row=1, column=0, sticky="w", padx=pad, pady=pad)
        self.entry_desc = tk.Entry(self, width=40)
        self.entry_desc.grid(row=1, column=1, padx=pad, pady=pad)

        # Category
        tk.Label(self, text="Category").grid(row=2, column=0, sticky="w", padx=pad, pady=pad)
        self.combo_category = ttk.Combobox(
            self,
            values=["electronics", "tools", "collectibles", "appliances", "misc"],
            state="readonly",
            width=37
        )
        self.combo_category.current(0)
        self.combo_category.grid(row=2, column=1, padx=pad, pady=pad)

        # Condition
        tk.Label(self, text="Condition").grid(row=3, column=0, sticky="w", padx=pad, pady=pad)
        self.combo_condition = ttk.Combobox(
            self,
            values=["new", "like new", "used", "fair", "broken"],
            state="readonly",
            width=37
        )
        self.combo_condition.current(2)
        self.combo_condition.grid(row=3, column=1, padx=pad, pady=pad)

        # Buy price
        tk.Label(self, text="Buy price (USD)").grid(row=4, column=0, sticky="w", padx=pad, pady=pad)
        self.entry_buy_price = tk.Entry(self, width=20)
        self.entry_buy_price.grid(row=4, column=1, sticky="w", padx=pad, pady=pad)

        # Analyze button
        self.btn_analyze = tk.Button(self, text="Analyze Flip", command=self.run_analysis)
        self.btn_analyze.grid(row=5, column=0, columnspan=2, pady=pad)

        # Output area
        tk.Label(self, text="Analysis result").grid(row=6, column=0, sticky="nw", padx=pad, pady=pad)
        self.text_output = tk.Text(self, width=60, height=15)
        self.text_output.grid(row=6, column=1, padx=pad, pady=pad)

    def run_analysis(self):
        try:
            item_name = clean_text(self.entry_name.get())
            item_desc = clean_text(self.entry_desc.get())
            category = clean_text(self.combo_category.get())
            condition = clean_text(self.combo_condition.get())
            buy_price = float(self.entry_buy_price.get())
        except ValueError:
            messagebox.showerror("Input error", "Buy price must be a number.")
            return

        if not item_name:
            messagebox.showerror("Input error", "Item name is required.")
            return

        market_data = fetch_market_data(item_name, category)
        ai_estimate = estimate_value(
            item_name,
            item_desc,
            category,
            condition,
            market_data
        )
        risk_score = compute_risk_score(
            buy_price=buy_price,
            ai_estimate=ai_estimate,
            market_data=market_data,
            condition=condition
        )
        analysis = analyze_item(
            item_name=item_name,
            item_desc=item_desc,
            category=category,
            condition=condition,
            buy_price=buy_price,
            market_data=market_data,
            ai_estimate=ai_estimate,
            risk_score=risk_score
        )

        self.text_output.delete("1.0", tk.END)
        self.text_output.insert(tk.END, json.dumps(analysis, indent=4))


if __name__ == "__main__":
    app = FlipFinderGUI()
    app.mainloop()
```

