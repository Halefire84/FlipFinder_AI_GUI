### risk_model.py

```python
def compute_risk_score(buy_price, ai_estimate, market_data, condition):
    volatility = market_data.get("volatility", 0.2)
    demand = market_data.get("demand_score", 0.6)

    if ai_estimate <= 0:
        margin_risk = 1.0
    else:
        margin = (ai_estimate - buy_price) / ai_estimate
        margin_risk = max(0.0, 1.0 - margin)

    cond_risk_map = {
        "new": 0.1,
        "like new": 0.2,
        "used": 0.4,
        "fair": 0.6,
        "broken": 0.85
    }
    condition_risk = cond_risk_map.get(condition, 0.5)

    risk = (
        0.4 * margin_risk +
        0.3 * volatility +
        0.2 * condition_risk +
        0.1 * (1 - demand)
    )

    return max(0.0, min(1.0, risk))
